# Tor config for SilkVault: SOCKS proxy (host :9051) + hidden service (.onion port 80 -> silkvault:5000)

# --- SOCKS5 proxy ---
SOCKSPort 0.0.0.0:9050
SOCKSPolicy accept *

# --- Logging (stdout so `docker logs` works) ---
Log notice stdout

# --- Data dir for relay keys, cached descriptors, etc. ---
DataDirectory /var/lib/tor

# --- Hidden service for SilkVault ---
HiddenServiceDir /var/lib/tor/silkvault_forum/
HiddenServiceVersion 3
HiddenServicePort 80 silkvault:5000

# We are not running as a relay; only as a client + onion service publisher.
ClientOnly 1
