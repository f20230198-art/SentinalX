# Tor config: SOCKS proxy on :9050 + hidden service (.onion port 80 -> forum:5000)

# --- SOCKS5 proxy (used by the scraper to make .onion HTTP requests) ---
SOCKSPort 0.0.0.0:9050
SOCKSPolicy accept *

# --- Logging (stdout so `docker logs` works) ---
Log notice stdout

# --- Data dir for relay keys, cached descriptors, etc. ---
DataDirectory /var/lib/tor

# --- Hidden service for the forum ---
HiddenServiceDir /var/lib/tor/sentinelx_forum/
HiddenServiceVersion 3
HiddenServicePort 80 forum:5000

# We are not running as a relay; only as a client + onion service publisher.
ClientOnly 1
